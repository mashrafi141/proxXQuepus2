# TeraBox Open Platform developer credentials.
# Apply for these from TeraBox. They must never be placed in the Android APK.
TERABOX_CLIENT_ID=
TERABOX_CLIENT_SECRET=
TERABOX_PRIVATE_SECRET=

# Optional: only needed if TeraBox is registered to call the backend HTTP callback
# flow. The documented Android flow returns the authorization code directly to
# the app's custom URL scheme and uses POST /v1/auth/exchange instead.
TERABOX_REDIRECT_URI=

# Deep link returned to the Android app. Must match the app's manifest.
APP_REDIRECT_BASE=proxxquepus://terabox-oauth

# Long random secret used to sign OAuth state values. Minimum 32 characters.
STATE_SIGNING_SECRET=

# Comma-separated list of public backend origins allowed to call this service.
# Native Android does not need CORS; leave empty unless a web client is used.
ALLOWED_ORIGINS=

# Optional operational settings.
TERABOX_TIMEOUT_SECONDS=20
AUTH_RATE_LIMIT_PER_MINUTE=10
ENABLE_API_DOCS=false
